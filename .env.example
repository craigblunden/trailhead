# Trailhead environment contract. Copy to `.env.local` and fill in the blanks.
#
# The values below are the LOCAL Supabase stack that `npm run supabase:start` brings up — they are
# the CLI's well-known development keys, not secrets. For the hosted project, every value comes
# from the Supabase and Vercel dashboards; `docs/provisioning.md` says where each one lives.

# --- Database (Prisma) ---------------------------------------------------------------------------
# Application role, NOBYPASSRLS, through Supavisor in TRANSACTION mode (port 6543 hosted, 54329
# locally). This is the only URL application code reads.
DATABASE_URL=postgresql://trailhead_app.pooler-dev:trailhead_app@127.0.0.1:54329/postgres
# Migrator role, NOBYPASSRLS, direct in SESSION mode (port 5432 hosted, 54322 locally). Used only by
# `prisma migrate`. Never used by the running application.
DIRECT_URL=postgresql://trailhead_migrator:trailhead_migrator@127.0.0.1:54322/postgres

# --- Supabase Auth + Storage ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# The `service_role` / secret key is deliberately absent. Nothing in this application uses it, and
# a test fails if one appears (ticket 15).

# --- Cover-letter generation (ticket 18) --------------------------------------------------------
# Server-side only; never prefixed NEXT_PUBLIC_. Leave blank to disable generation locally.
ANTHROPIC_API_KEY=

# --- Footing (footing ticket 01) -----------------------------------------------------------------
# The second AI provider: TypeSafe scores a Job's posting against its Application kit. Server-side
# only; never prefixed NEXT_PUBLIC_. Leave blank and the Footing card is absent rather than broken —
# unavailable, not broken, the same way a missing ANTHROPIC_API_KEY works.
# TYPESAFE_BASE_URL is honoured by the SDK and is only ever set to point the test suites at a fake.
TYPESAFE_API_KEY=

# --- App feedback, optional ---------------------------------------------------------------------
# The header's Feedback button emails the owner through Resend. Server-side only. `RESEND_API_KEY`
# is set by the Resend integration on Vercel. Without a key or a recipient, a send fails and says so.
# The sender must be on a domain verified in Resend; left blank, Resend's shared test sender is used,
# which only delivers to the address the Resend account was created with.
RESEND_API_KEY=
APP_FEEDBACK_TO_EMAIL=
APP_FEEDBACK_FROM_EMAIL=

# --- Social sign-in (ticket 07), optional ----------------------------------------------------------
# A provider's button renders only when BOTH of its values are set; the app only checks that they are
# present. On the hosted project the credentials are also entered in the Auth dashboard. Locally, the
# provider must be enabled in `supabase/config.toml` too — see docs/provisioning.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# --- Tests only ---------------------------------------------------------------------------------
# Mailpit's HTTP API, where the local stack delivers verification and reset mail. The e2e suite
# reads links out of it. Unset in production.
TEST_MAIL_API_URL=http://127.0.0.1:54324
# The local stack as `postgres`, for the two things only that role may do in tests: run the pg_cron
# document sweep, and remove the accounts an e2e run created. Loopback only; this is the CLI default.
TEST_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
