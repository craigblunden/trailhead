// Trailhead schema. Supabase Auth owns the `auth` schema; nothing here models users. A row's
// owner is its `userId` — the Supabase user id — and every table carries one directly, so the
// tenant policies (see the migrations) test a column rather than reaching through a parent.
//
// The datasource URL lives in `prisma.config.ts` — Prisma 7 rejects it here (P1012).
//
// Boundaries:
// - An applied migration is never edited. A change is a new migration.
// - Only `src/server/db/` imports the generated client. Mappers are the boundary to the app.
// - The models are Job, Contact, ActivityEntry, Document, the Job↔Contact link, the weekly
//   generation quota, the Tenant's Plan, and the Interview Simulator's Attempt, AttemptQuestion,
//   and weekly InterviewQuota. No Analysis, Requirement, Evidence, queue, or job-state table:
//   that work left the phase deliberately.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // The sweep's partial indexes on Document. Migrate reads them from here, so it never drops them.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// Members match `STAGES` in `src/lib/jobs.ts` exactly; `src/server/db/enum-assertions.ts`
/// fails the typecheck if they drift. The board's columns derive from the same set.
enum Stage {
  interested
  applied
  interviewing
  offer
  rejected
}

/// Members match the keys of `ACCENTS` in `src/lib/jobs.ts`.
enum Accent {
  moss
  forest
  teal
  wheat
  olive
  slate
}

/// "Recruiter" is a kind of Contact, not a separate thing (CONTEXT.md).
enum ContactKind {
  recruiter
  hiring_manager
  referrer
  other
}

enum DocumentKind {
  resume
  cover_letter
}

/// Members match `PLANS` in `src/lib/plans.ts`; `enum-assertions.ts` fails the typecheck if they drift.
enum Plan {
  free
  basic
  pro
}

/// Where a Document is in ingestion. `pending`: the row exists, the object may not yet.
/// `ready`: uploaded and text extracted. `failed`: uploaded but unusable (ticket 19 says why).
enum IngestionState {
  pending
  ready
  failed
}

/// One role at one company the user is pursuing, from lead to outcome.
model Job {
  id              String          @id @default(cuid(2))
  userId          String          @db.Uuid
  company         String
  role            String
  /// Free text as it reads on the card, e.g. "Hybrid · Brisbane".
  location        String
  /// Thousands per year. Null on either end means that bound is unknown.
  salaryMin       Int?
  salaryMax       Int?
  stage           Stage           @default(interested)
  postingUrl      String          @default("")
  /// Dates, not timestamps: a timestamp reintroduces the timezone drift the string form prevents.
  addedOn         DateTime        @db.Date
  appliedOn       DateTime?       @db.Date
  description     String          @default("")
  notes           String          @default("")
  /// The message the company sent turning the user down, pasted for reference. Kept when the Job
  /// leaves rejected; the page shows it only while the Job is rejected.
  rejectionLetter String          @default("")
  accent          Accent
  /// The resume sent with this Job, if any. Deleting the Document leaves the Job intact.
  /// Renamed from `documentId` when cover letters got their own reference (ticket 17).
  resumeId        String?
  resume          Document?       @relation("JobResume", fields: [resumeId], references: [id], onDelete: SetNull)
  /// The cover letter sent with this Job, if any. The tenant policy checks both kinds.
  coverLetterId   String?
  coverLetter     Document?       @relation("JobCoverLetter", fields: [coverLetterId], references: [id], onDelete: SetNull)
  /// The last letter written for this Job (ADR-0002): its Draft. Empty when none has been written.
  /// Each write replaces it; it goes with the Job, and it is never a Document.
  draft           String          @default("")
  draftWrittenAt  DateTime?
  contacts        JobContact[]
  activity        ActivityEntry[]
  attempts        Attempt[]
  footings        Footing[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  /// The board lists a user's jobs in creation order, so reloads never reshuffle.
  @@index([userId, createdAt])
  @@index([resumeId])
  @@index([coverLetterId])
}

/// A dated line in a Job's history, written by the system as a side effect of change.
model ActivityEntry {
  id        String   @id @default(cuid(2))
  userId    String   @db.Uuid
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label     String
  /// The user-visible date.
  date      DateTime @db.Date
  /// The tiebreak: two entries on the same day still have a defined "newest first".
  createdAt DateTime @default(now())

  @@index([jobId, date(sort: Desc), createdAt(sort: Desc)])
  @@index([userId])
}

/// A person the user knows in connection with their search, owned by the user rather than by
/// any one Job. Agency is a field, not an entity.
model Contact {
  id           String       @id @default(cuid(2))
  userId       String       @db.Uuid
  name         String
  kind         ContactKind  @default(other)
  /// Their title where they work, e.g. "Design Manager".
  title        String       @default("")
  email        String       @default("")
  phone        String       @default("")
  /// The independent firm a recruiter works for, when it differs from the company hiring.
  agency       String       @default("")
  notes        String       @default("")
  /// http(s) only, sanitised on write like `Job.postingUrl` (ticket 14). Blank means none.
  linkedinUrl  String       @default("")
  /// Set by the user; activity entries are job-scoped, so there is nothing to derive it from.
  lastSpokenOn DateTime?    @db.Date
  jobs         JobContact[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// The contacts route lists a user's contacts by name.
  @@index([userId, name])
}

/// The many-to-many link between Jobs and Contacts. Explicit rather than implicit so it can carry
/// its own `userId` for the tenant policy, like every other table.
model JobContact {
  jobId     String
  contactId String
  userId    String   @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([jobId, contactId])
  @@index([contactId])
  @@index([userId])
}

/// A file the user uploaded — a resume or a cover letter — owned by the user and attachable to
/// as many Jobs as they like. Never versioned in place: a new upload is a new Document.
model Document {
  id             String         @id @default(cuid(2))
  userId         String         @db.Uuid
  kind           DocumentKind
  /// The name the user uploaded it as, for display.
  fileName       String
  /// `<userId>/<id>.<ext>` in the private `documents` bucket. The row exists before the object.
  storageKey     String         @unique
  mimeType       String
  sizeBytes      Int            @default(0)
  /// Extracted at upload. Doubles as the content hash for later comparison.
  text           String         @default("")
  ingestion      IngestionState @default(pending)
  /// Why ingestion failed, as a code the UI can explain (ticket 19). Null unless `failed`.
  ingestionError String?
  /// Tombstone (ticket 16): set first, then the object is removed, then the row is hard-deleted.
  deletedAt      DateTime?
  resumeFor      Job[]          @relation("JobResume")
  coverLetterFor Job[]          @relation("JobCoverLetter")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// The documents route lists a user's documents newest-first.
  @@index([userId, createdAt])
  /// The sweep (`public.sweep_documents()`) looks across every user for uploads left unfinished and for
  /// tombstones old enough to finish, both by age. Few rows are ever either, so each index holds only those.
  @@index([createdAt], map: "Document_unfinished_createdAt_idx", where: raw("\"deletedAt\" IS NULL AND ingestion <> 'ready'"))
  @@index([createdAt], map: "Document_tombstoned_createdAt_idx", where: raw("\"deletedAt\" IS NOT NULL"))
}

/// Cover letters taken from one user's weekly quota (ticket 18). Weeks start Monday, UTC. Reserved
/// atomically before the Claude call and given back if no letter is delivered (see
/// src/server/data/generation.ts). `flagged` counts this week's Flags; a Tenant is on Hold while it
/// is two or more, so a Hold lapses with the week and is never stored (feedback issue 01).
model GenerationQuota {
  userId    String   @db.Uuid
  weekStart DateTime @db.Date
  used      Int      @default(0)
  flagged   Int      @default(0)
  updatedAt DateTime @default(now())

  @@id([userId, weekStart])
}

/// Which Plan a Tenant is on (ADR-0001). No row means the default Plan. The app role reads this
/// under the tenant policy and has no grant to write it: only `npm run db:plan`, as the migrator,
/// puts a Tenant on a Plan.
model UserPlan {
  userId    String   @id @db.Uuid
  plan      Plan
  updatedAt DateTime @default(now())
}

/// An Account's record of having agreed to one version of the terms (CONTEXT.md; ADR-0008).
/// Append-only: a new version is a new row, never an edit to the old one, so the history says who
/// accepted what and when. `acceptedAt` is the only timestamp for the same reason a Footing has only
/// `scoredAt`: an `updatedAt` would imply a row that can be updated, and nothing updates one.
///
/// Deliberately NOT Supabase `user_metadata`. That is writable by the user it belongs to, so it
/// cannot hold a record ABOUT that same user — do not "simplify" this table away into it.
model TermsAcceptance {
  userId     String   @db.Uuid
  /// `TERMS_VERSION` in `src/lib/terms.ts` as it stood when this was accepted.
  version    String
  acceptedAt DateTime @default(now())

  @@id([userId, version])
}

/// The five things a Footing scores. Members match `FOOTING_DIMENSIONS` in `src/lib/footing.ts`;
/// `enum-assertions.ts` fails the typecheck if they drift.
///
/// Named `Dimension` rather than `FootingDimension` only because the table below already has that
/// name, which is the glossary's term for one scored dimension of one Footing. The enum says which
/// dimension; the table says how that dimension scored.
enum Dimension {
  skills
  experience
  domain
  proof_of_work
  letter
}

/// A **Footing** (CONTEXT.md; ADR-0007): the kept result of scoring one Job's posting against its
/// Application kit. **Append-only** — scoring inserts, and nothing ever updates or deletes one. The
/// newest row for a Job is "the Footing"; the rest are its history, which is what makes "is my
/// rewritten resume actually doing better here" answerable at all.
///
/// **The overall is not a column.** It is computed from the four weighted dimensions at read time, so
/// changing the weights re-reads history correctly instead of leaving a number no formula explains.
///
/// No `createdAt`/`updatedAt`, unlike most tables here, and deliberately: `scoredAt` is when this row
/// came to exist, and an `updatedAt` would imply a row that can be updated. Nothing updates one.
///
/// The staleness stamp is hashes rather than copies — `Document.text` already "doubles as the content
/// hash for later comparison" — and `resumeId`/`coverLetterId` are plain columns with **no relation**
/// on purpose: a Footing whose Document was later deleted is kept and reads permanently stale, so the
/// stamp has to outlive the Document rather than cascade away with it.
model Footing {
  id              String             @id @default(cuid(2))
  userId          String             @db.Uuid
  jobId           String
  job             Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scoredAt        DateTime           @default(now())
  /// The Documents that were in the Application kit when this ran. Not foreign keys — see above.
  resumeId        String?
  coverLetterId   String?
  /// SHA-256 of each text as it stood. Empty string where there was nothing to hash.
  resumeHash      String
  descriptionHash String
  coverLetterHash String
  dimensions      FootingDimension[]

  /// The job page asks for this Job's Footings, newest first.
  @@index([userId, jobId, scoredAt(sort: Desc)])
}

/// One **Footing dimension** of one Footing: where it landed, and how sure the provider was.
/// One row per dimension per Footing, so a dimension is a column a later cross-Job pass can query
/// (ADR-0007) rather than a field inside a JSON blob.
model FootingDimension {
  footingId  String
  userId     String    @db.Uuid
  footing    Footing   @relation(fields: [footingId], references: [id], onDelete: Cascade)
  dimension  Dimension
  /// 0–100, already normalised from the rubric's levels. Shown as a band, never as a number.
  score      Int
  /// The provider's own confidence in that position, 0–1.
  confidence Float

  @@id([footingId, dimension])
  @@index([userId])
}

/// The five fixed dimensions an Attempt's questions are drawn from. Members match `CATEGORIES` in
/// `src/lib/interview.ts`; `enum-assertions.ts` fails the typecheck if they drift.
enum Category {
  personal
  behavioural
  stakeholder
  technical
  design
}

/// One timed run of the Interview Simulator against one Job (interview simulator ticket 01). Its
/// question set is generated once and persisted, so a resumed Attempt asks exactly what it asked
/// the first time. `activeSeconds` is active-time accounting, not a wall-clock deadline: it grows
/// only while questions are actually being answered, so a closed tab does not drain the budget.
model Attempt {
  id            String            @id @default(cuid(2))
  userId        String            @db.Uuid
  jobId         String
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Minutes. One of `ATTEMPT_LENGTHS`; which are offered depends on the Tenant's Plan.
  length        Int
  startedAt     DateTime          @default(now())
  /// Seconds this Attempt has been answered for. The countdown is `length * 60` less this.
  activeSeconds Int               @default(0)
  /// Set once every question has an Answer, or the countdown ran out mid-question.
  completedAt   DateTime?
  /// The Scorecard's overall score, 0–100. Null until the Attempt is scored.
  overallScore  Int?
  /// The Takeaway once scored: two or three { point, from } objects (interview second pass ticket 05).
  /// Empty on an Attempt scored before there was one, and on one with nothing reached to score.
  takeaway      Json              @default("[]")
  /// How many times this Attempt has been scored successfully, capped at `MAX_SCORE_RUNS`. Scoring
  /// spends no quota, so this is the only thing bounding the model call behind it; a failed scoring
  /// is given back, so a retry is still free. Internal — never on the Attempt DTO.
  scoreRuns     Int               @default(0)
  questions     AttemptQuestion[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  /// The Job's detail page and the hub both ask for this Job's newest Attempt.
  @@index([userId, jobId, startedAt(sort: Desc)])
}

/// One generated question in an Attempt, with its Category and its place in the order. Persisted at
/// generation time and never regenerated. Its Answer is the same row: a question has at most one.
model AttemptQuestion {
  id           String    @id @default(cuid(2))
  userId       String    @db.Uuid
  attemptId    String
  attempt      Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  category     Category
  /// Position in the Attempt, from 0.
  order        Int
  text         String
  /// What the Tenant said, spoken or typed — the two input modes write the same field. Empty until
  /// answered; a question left mid-answer when the Tenant navigated away stays empty.
  transcript   String    @default("")
  answeredAt   DateTime?
  /// The Answer's score, 0–100. Null until the Attempt is scored.
  score        Int?
  /// Why it was marked that way, as Answers were scored before interview second pass ticket 05. Empty since.
  rationale    String    @default("")
  /// What landed in the Answer, in one sentence. Empty on an Answer scored before there was one.
  whatLanded   String    @default("")
  /// One to three Missed points: specific things from the posting or resume the Answer could have said.
  missedPoints String[]  @default([])

  @@unique([attemptId, order])
  @@index([userId])
}

/// Interview Attempts taken from one user's weekly quota. Weeks start Monday, UTC, like the
/// cover-letter quota — but its own table, because that one's Flag and Hold semantics are specific
/// to cover-letter Feedback abuse and mean nothing here. Reserved atomically before generation runs
/// and given back only if generation fails (see src/server/data/interview.ts).
model InterviewQuota {
  userId    String   @db.Uuid
  weekStart DateTime @db.Date
  used      Int      @default(0)
  updatedAt DateTime @default(now())

  @@id([userId, weekStart])
}

/// A Practice round (CONTEXT.md; practice round ticket 03): a short, general, unscored run of the
/// Interview Simulator for a Tenant whose Plan cannot start an Attempt. Stored apart from Attempt on
/// purpose (ADR-0006): it has no Job, no length, no quota, and no Scorecard. Its countdown is fixed
/// (`PRACTICE_SECONDS`), so only the seconds answered for are stored.
model PracticeRound {
  id            String             @id @default(cuid(2))
  userId        String             @db.Uuid
  startedAt     DateTime           @default(now())
  /// Seconds this round has been answered for. The countdown is `PRACTICE_SECONDS` less this.
  activeSeconds Int                @default(0)
  /// Set once every question has an Answer, or the countdown ran out mid-question.
  completedAt   DateTime?
  questions     PracticeQuestion[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  /// The unfinished round, the previous round's questions, and the hub's list all read newest first.
  @@index([userId, startedAt(sort: Desc)])
}

/// One question in a Practice round, with its Answer on the same row. Its text is stored rather than a
/// reference into the fixed question set, so editing the set never rewrites a round already taken.
model PracticeQuestion {
  id         String        @id @default(cuid(2))
  userId     String        @db.Uuid
  roundId    String
  round      PracticeRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  category   Category
  /// Position in the round, from 0.
  order      Int
  text       String
  /// What the Tenant said, spoken or typed. Empty until answered.
  transcript String        @default("")
  answeredAt DateTime?

  @@unique([roundId, order])
  @@index([userId])
}
